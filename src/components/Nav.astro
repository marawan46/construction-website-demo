---
import { useTranslations } from '../i18n/ui';

const lang = Astro.currentLocale as 'en' | 'ar';

const t = useTranslations(lang);

const homeHref = lang === 'ar' ? '/ar/' : '/';
const aboutHref = lang === 'ar' ? '/ar/about' : '/about';
---


<nav id="main-nav" class="navbar fixed top-0 z-50 py-1 bg-transparent shadow-sm transition-all">
<div class="container flex font-heading font-bold max-w-1xl m-auto">  
  <div class="navbar-start">
    <div class="dropdown">
      <div tabindex="0" role="button" class="btn btn-ghost text-white lg:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu-icon lucide-menu"><path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h16"/></svg>      </div>
      <ul
        tabindex="-1"
        class="menu menu-sm dropdown-content  bg-white rounded-box z-20 mt-3 w-52 p-2 shadow">
        <li><a>{t('nav.home')}</a></li>        
        <li><a>{t('nav.about')}</a></li>
        <li><a href="#Projects">{t('nav.project')}</a></li>
        <li><a>{t('nav.service')}</a></li>
      </ul>
    </div>
    <a class="">
        <img src="logo.svg" class="" width="80px" alt="">
    </a>
  </div>
  <div class="navbar-center hidden lg:flex">
    <ul id="nav" class="menu menu-horizontal gap-10 text-lg text-white px-1">
        <li><a>{t('nav.home')}</a></li>        
        <li><a>{t('nav.about')}</a></li>
        <li><a href="#Projects">{t('nav.project')}</a></li>
        <li><a href="#Services">{t('nav.service')}</a></li>
        <li><a>{t('nav.ourteam')}</a></li>
    </ul>
  </div>
<div class="navbar-end">
  <a href="#Contact" class="group relative inline-flex items-center justify-center p-3 md:px-8 md:py-3 font-bold text-slate-900 transition-all duration-300 bg-amber-400 rounded-md overflow-hidden hover:bg-amber-300 hover:shadow-[0_0_20px_rgba(251,191,36,0.4)] active:scale-95">
    
    <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 bg-linear-to-r from-transparent via-white/40 to-transparent"></div>

    <span class="relative text-sm md:text-lg z-10 flex items-center gap-2">
      {t('nav.freequote')}
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1">
        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
      </svg>
    </span>

  </a>
</div>
</div>

</nav>


<script>
  const nav = document.getElementById('main-nav');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      // الكلاسات عند التمرير لأسفل (خلفية غامقة مثلاً)
      nav?.classList.add('bg-slate-900', 'shadow-md', 'py-2');
      nav?.classList.remove('bg-transparent', 'py-4');
    } else {
      // العودة للحالة الأصلية عند الصعود للأعلى
      nav?.classList.add('bg-transparent', 'py-4');
      nav?.classList.remove('bg-slate-900', 'shadow-md', 'py-2');
    }
  });
</script>