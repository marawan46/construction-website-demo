---
import { Image } from 'astro:assets';
import { useTranslations } from "../i18n/ui";
import data from '../content/why.json';

const lang = Astro.currentLocale as 'en' | 'ar';
const t = useTranslations(lang);
const dir = lang === 'ar' ? 'rtl' : 'ltr';

// Accessing the array based on your variable
const why = data[lang].whyus;

// Icon Mapping
const WhyIcons = {
  Experience: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  Shield: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  Users: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>`,
  Home: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>`,
  Clock: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`
};
---

<section id="Whyus" dir={dir} class="bg-[#f4f4f4] py-16 px-6">
  <div class="max-w-7xl mx-auto">
    
    <div class="flex items-center gap-4 mb-10">
      <h2 class="text-2xl md:text-3xl font-bold text-[#1a2b3c] whitespace-nowrap">
        {t('whyus.title')}
      </h2>
      <div class="h-px w-full bg-gray-300"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <div class="lg:col-span-4 rounded-sm overflow-hidden shadow-xl">
        <Image 
          src="/966.jpg" 
          alt="MM Builders" 
          width={600} 
          height={400}
          class="w-full h-full object-cover"
        />
      </div>

      <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-2 gap-4">
        {why.map((item,index) => (
          <div data-aos="fade-up" data-aos-delay={100*index} class="group flex items-center gap-4 bg-white p-5 rounded-sm shadow-sm border-s-4 border-transparent hover:border-amber-400 transition-all">
            <div class="text-[#1a2b3c] group-hover:text-amber-500 transition-colors">
              <Fragment set:html={WhyIcons[item.icon as keyof typeof WhyIcons]} />
            </div>
            <span class="font-bold text-[#1a2b3c]">{item.feat}</span>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>