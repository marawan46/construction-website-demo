---
import { useTranslations } from "../i18n/ui";
import QuoteForm from "./QuoteForm";

const lang = Astro.currentLocale as 'en' | 'ar';
const t = useTranslations(lang);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
---

<section id="Contact" dir={dir}  class="bg-white py-16 px-4 md:scroll-mt-[25vh]">
  <div class="max-w-6xl mx-auto">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <div class="lg:col-span-4 flex flex-col gap-8">
        <div>
          <h2 class="text-2xl font-bold text-slate-800 mb-2">{t('contact.info')}</h2>
          <div class="h-1 w-12 bg-amber-400"></div>
        </div>
        
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="p-3 bg-slate-50 rounded-md text-amber-600">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <div>
              <p class="text-sm text-slate-500">{t('contact.phone')}</p>
              <p class="font-bold text-slate-800" dir="ltr">+966 50 000 0000</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="p-3 bg-slate-50 rounded-md text-amber-600">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div>
              <p class="text-sm text-slate-500">{t('contact.email')}</p>
              <p class="font-bold text-slate-800">info@mmbuilders.com</p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-8 bg-slate-50 p-8 rounded-sm">
        <h3 class="text-xl font-bold text-slate-800 mb-6">{t('contact.title')}</h3>
        

        <QuoteForm client:load />

        <!-- <form action="#" class="grid grid-cols-1 md:grid-cols-2 gap-4">
