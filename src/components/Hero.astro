---
import { useTranslations } from '../i18n/ui';
import Services from './Services.astro';
import { Image } from 'astro:assets';

const lang = Astro.currentLocale as 'en' | 'ar';
const dir = lang==='en' ? 'ltr' : 'rtl'
const t = useTranslations(lang);
---
<section dir={dir} class="relative bg-gray-900 text-white overflow-hidden pt-24 sm:pt-32 lg:pt-40">
  <div class="absolute inset-0 z-0">
    <Image src="https://images.unsplash.com/photo-1541888946425-d81bb19240f5?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" 
    width={1920}
    height={1080}     
    alt="Construction Site" 
         class="h-full w-full object-cover opacity-40"/>
         

    <div class="absolute inset-0 bg-linear-to-r from-gray-900 via-gray-900/70 to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-2xl lg:mx-0">
      <div class="mb-6 flex items-center gap-x-3">
        <span class="h-px w-8 bg-yellow-500"></span>
        <span class="text-sm font-semibold tracking-wider uppercase text-yellow-500">Building Tomorrow's Skyline</span>
      </div>

      <h1 data-aos="fade-up" class="title text-4xl font-bold tracking-tight sm:text-6xl leading-tight">
        {t('hero.head1')} <br/>
        <span class="text-yellow-500">{t('hero.head2')}</span>
      </h1>
      
      <p data-aos="fade-up" data-aos-delay="200" class="description mt-6 text-lg leading-8 text-gray-300">
        {t('hero.sub')}
    </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center gap-4">
        <a href="#Contact" class="w-full sm:w-auto rounded-md bg-yellow-500 px-8 py-4 text-center text-sm font-semibold text-gray-900 shadow-sm hover:bg-yellow-400 transition-all transform hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-500">
          {t('hero.btn1')}
        </a>
        <a href="#Services" class="w-full sm:w-auto rounded-md border border-white/30 bg-white/10 backdrop-blur-md px-8 py-4 text-center text-sm font-semibold text-white hover:bg-white/20 transition-all">
            {t('hero.btn2')}
        </a>
      </div>
    </div>
  </div>

  <Services />



  <div class="absolute top-90 ltr:right-5 rtl:left-30 hidden lg:block p-10">
    <div class="flex relative gap-10 border-l-4 p-5 filter backdrop-blur-md rounded-md bg-gray-500/20 border-white/20 pl-10">
      <div aria-label="success" class="absolute z-50 top-5 left-5 animate-ping status status-success status-lg"></div>
        
        <div>
        <p id="stat-number" data-target={t('hero.exp.num')} class="text-4xl font-bold">{t('hero.exp.num')}</p>
        <p class="text-sm uppercase tracking-widest text-gray-400">{t('hero.exp')}</p>
      </div>
      <div>
        <p id="stat-number" data-target={t('hero.projects.num')} class="text-4xl font-bold">{t('hero.projects.num')}</p>
        <p class="text-sm uppercase tracking-widest text-gray-400">{t('hero.projects')}</p>
      </div>
    </div>
  </div>
</section>




<script>
import AOS from 'aos';
import gsap from 'gsap' 
import 'aos/dist/aos.css';
window.addEventListener('DOMContentLoaded',()=>{

AOS.init({
    duration: 800,
    once: true,   
  });

document.querySelectorAll('#stat-number').forEach(el => {
  const targetValue = el.getAttribute("data-target");
  
  gsap.from(el, {
    textContent: 0,
    duration: 2,
    snap: { textContent: 1 },
    scrollTrigger: { trigger: el, start: "top 90%" },
    onUpdate: function() {
      // بيضيف الـ + بعد الرقم
      el.innerHTML = Math.floor(this.targets()[0].textContent) + "+";
    }
  });
});
})

</script>